#include <winver.h>
// VU_RC_VERSION (e.g. 0,4,1,0) and VU_RC_VERSION_STR ("0.4.1") come from build.sh, which takes
// them from VU_VERSION_STR in src/common.h: the app reads the installed version from here.
#ifndef VU_RC_VERSION
#error "build with -DVU_RC_VERSION=... -DVU_RC_VERSION_STR=... (see build.sh)"
#endif
VS_VERSION_INFO VERSIONINFO
FILEVERSION VU_RC_VERSION
PRODUCTVERSION VU_RC_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "vrupscale"
            VALUE "FileDescription", "vrupscale: SteamVR compositor temporal upscaler (dxgi.dll forwarder)"
            VALUE "FileVersion", VU_RC_VERSION_STR
            VALUE "InternalName", "vrupscale"
            VALUE "OriginalFilename", "dxgi.dll"
            VALUE "ProductName", "vrupscale"
            VALUE "ProductVersion", VU_RC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
